# Copia este fichero a .env y cambia los valores. .env está en .gitignore: no lo subas nunca.

# MongoDB (usuario administrador que crea el contenedor en el primer arranque)
MONGODB_USER=oxygen
MONGODB_PASS=cambia-esta-contraseña

# JWT: genera un secreto largo, por ejemplo con:  openssl rand -hex 32
JWT_SECRET_KEY=cambia-este-secreto
JWT_EXPIRE_TIME=1h

# Puertos publicados en tu máquina
WEB_PORT=3000
API_PORT=8000

# URL de la API tal como la ve el navegador (se incrusta al compilar el frontend)
REACT_APP_API_ENDPOINT=http://localhost:8000/api
